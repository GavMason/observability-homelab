# Global options
{
	auto_https off
	admin :2019
	servers {
		metrics
	}
}

# Homepage Dashboard
http://homelab.internal {
	reverse_proxy homepage:3000
}

# Grafana
http://grafana.homelab.internal {
	reverse_proxy grafana:3000
}

# Prometheus — basic auth
http://prometheus.homelab.internal {
	basic_auth {
		{$CADDY_BASIC_AUTH_USER:admin} {$CADDY_BASIC_AUTH_HASH}
	}
	reverse_proxy prometheus:9090
}

# Alertmanager — basic auth
http://alertmanager.homelab.internal {
	basic_auth {
		{$CADDY_BASIC_AUTH_USER:admin} {$CADDY_BASIC_AUTH_HASH}
	}
	reverse_proxy alertmanager:9093
}

# cAdvisor — basic auth
http://cadvisor.homelab.internal {
	basic_auth {
		{$CADDY_BASIC_AUTH_USER:admin} {$CADDY_BASIC_AUTH_HASH}
	}
	reverse_proxy cadvisor:8080
}

# Uptime Kuma
http://uptime-kuma.homelab.internal {
	reverse_proxy uptime-kuma:3001
}

# Portainer
http://portainer.homelab.internal {
