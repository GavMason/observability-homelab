# Grafana Configuration
GF_USER=admin
GF_PASS=<your_password>

# Grafana Server Settings
GF_SERVER_ROOT_URL=http://grafana.homelab.internal
GF_SERVER_DOMAIN=grafana.homelab.internal

# Prometheus Configuration
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB

# Ports
GRAFANA_PORT=3333
PROMETHEUS_PORT=9191
CADVISOR_PORT=8181
ALERTMANAGER_PORT=9393

# Discord Webhook Configuration
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Caddy Configuration
CADDY_HTTP_PORT=80
CADDY_BASIC_AUTH_USER=admin
CADDY_BASIC_AUTH_HASH=<your_bcrypt_hash_from_caddy_hash-password>

# Homepage Configuration
HOMEPAGE_PORT=3001
HOMEPAGE_ALLOWED_HOSTS=homelab.internal,localhost

# Uptime Kuma Configuration
UPTIME_KUMA_PORT=3002

# Loki Configuration
LOKI_PORT=3100

# Code Server Configuration
CODE_SERVER_PORT=8443
CODE_SERVER_PASS=<your_password>