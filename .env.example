# Grafana Configuration
GF_USER=admin
GF_PASS=<your_password>

# Grafana Server Settings
GF_SERVER_ROOT_URL=http://grafana.homelab.local
GF_SERVER_DOMAIN=grafana.homelab.local

# Prometheus Configuration
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB

# Ports
GRAFANA_PORT=3333
PROMETHEUS_PORT=9191
CADVISOR_PORT=8181
ALERTMANAGER_PORT=9393

# Discord Webhook Configuration
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Caddy Configuration
CADDY_HTTP_PORT=80

# Homepage Configuration
HOMEPAGE_PORT=3001
HOMEPAGE_ALLOWED_HOSTS=homepage.homelab.local,homelab.local,localhost

# Uptime Kuma Configuration
UPTIME_KUMA_PORT=3002